# Dependencies
node_modules/

# Build output is retained for the complete project handoff

# Nuxt UI generated files
.nuxt-ui/
auto-imports.d.ts
components.d.ts

# Local environment
.env
.env.*
!.env.example

# Logs
*.log
*.out
*.err
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python runtime artifacts
__pycache__/
*.py[cod]
backend/.venv/
.pytest_cache/
.pnpm-store/
.workbuddy/memory/2026-08-17.md

# Private material and portable repository history never enter GitHub
private/
/history/
**/credentials/
*.pem
*.key
*.p12
*.pfx
*.bundle

# Data cleaning — 原始数据和中间运行目录不入库
data-cleaning/storage/
data-cleaning/data-cleaning/storage/
data-cleaning/storage/raw_organized/
data-cleaning/storage/cleaned/
data-cleaning/storage/rasters/
data-cleaning/storage/raw/
data-cleaning/storage/silver/
data-cleaning/storage/gold/
data-cleaning/storage/runs/
data-cleaning/storage/exports/
data-cleaning/storage/databases/
data-cleaning/storage/releases/
data-cleaning/storage/staging/
data-cleaning/storage/THQBCA-V2/
data-cleaning/storage/THQBCA-V2.rar

# Large/binary data formats are excluded globally; small CSV/JSON schemas remain allowed
*.parquet
*.feather
*.sqlite
*.sqlite3
*.db
*.tif
*.tiff
*.hdf
*.h5
*.hdf5
*.nc
*.nc4
*.grib
*.grib2
*.rar
*.7z
*.zip
*.tar
*.tar.gz

# 正式清洗发布包、审计清单和报告允许进入 GitHub。
# 这些例外放在文件末尾，以覆盖上面的 storage 与二进制格式规则。
!data-cleaning/storage/
data-cleaning/storage/*
!data-cleaning/storage/final_cleaned/
!data-cleaning/storage/final_cleaned/**
!data-cleaning/storage/exports/
!data-cleaning/storage/exports/**
!data-cleaning/storage/manifests/
!data-cleaning/storage/manifests/**
