# 正式清洗发布包、审计清单和报告允许进入 GitHub。
# 这些例外放在文件末尾，以覆盖上面的 storage 与二进制格式规则。
!data-cleaning/storage/
data-cleaning/storage/*
!data-cleaning/storage/final_cleaned/
!data-cleaning/storage/final_cleaned/**
!data-cleaning/storage/exports/
!data-cleaning/storage/exports/**
!data-cleaning/storage/manifests/
!data-cleaning/storage/manifests/**

# 卫星遥感年度 PNG（build_rs_overlays.py 生成产物，脚本可复现）
# v1.1 起随仓库分发：队友克隆即含时空推演图层（原始推演产物保留、可由脚本重建）
backend/rs_overlays/
!backend/rs_overlays/
!backend/rs_overlays/**

# 运行时缓存与本地临时（不入库）
backend/.qa_pytest_tmp/
__nonexistent__/

# V0.3 交付包的中间备份副本：与正式产物同源、可由流水线重跑复现，
# 保留在磁盘供追溯，但不属于发布内容（封版提交只含正式产物）。
backend/model_runtime_v0_3/*backup*/
backend/model_runtime_v0_3/*_backup/
backend/model_runtime_v0_3/_derived_backup_*/

# 预警中心运行态（2026-09-12 复审整改；2026-09-14 起改为随仓库分发，见文件末白名单）：
# 事件/通知/状态由运行中的系统持续改写，运行后会产生已修改增量，按需提交。
backend/alerts-data/
dist_check_*/

# ── 正式版 v1.1：小型运行数据包随仓库分发（队友克隆即含算法数据支持）──
!data/A23_小型运行数据包_V1.0/realtime_catalog/observations.parquet

# v0.3 交付包三个小型 parquet（合计约 330KB，2026-09-14 部署一致性修复）：
# features_base 是 serving 月度上下文与 XAI 敏感性步长的运行时输入（缺失会静默
# 降级、克隆端预测数值与开发机不一致），pairs/labels 保证重训链完整，必须随仓库分发。
!backend/model_runtime_v0_3/pair_dataset/pairs.parquet
!backend/model_runtime_v0_3/supervised/features_base.parquet
!backend/model_runtime_v0_3/supervised/labels_wide.parquet

# ── 运行期历史随仓库分发（2026-09-14 用户决策：队友克隆即含全部运行积累）──
# alerts-data=告警/事件/审计处置历史；prediction-cache/snapshots=预测快照历史
#（123 期，原始 JSON 压缩率高，git 包仅约数十 MB）。二者在开发机上仍会被运行中的
# 系统改写/新增，产生的增量属未跟踪或已修改状态，按需提交即可。
!backend/alerts-data/
!backend/alerts-data/**
!backend/prediction-cache/
!backend/prediction-cache/**
# 实时采集历史冻结档案（providers 默认解析的回退目录，见 data/realtime_history/README.md）
!data/realtime_history/mee_realtime/observations.parquet

# 本地备份（审计/审查/PPT素材/临时件）——只留本地，永不上传
_local_backup_*/
